{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackyreaps/guild-system/schemas/local-charter.checklist.json",
  "title": "Local Guild Charter — required sections checklist",
  "description": "Checklist derived from GS-CHR-010 §2. A Local Guild Charter is valid only if every required section is present.",
  "type": "object",
  "required": [
    "guild_identity",
    "jurisdictions",
    "legal_form",
    "membership_rules",
    "internal_governance",
    "currency_system",
    "merit_calibration",
    "contribution_verification",
    "founding_orientation",
    "shear_detection",
    "fork_conditions",
    "guardrail_declaration",
    "conflict_of_interest",
    "legal_compliance",
    "counsel_contact",
    "legal_annex_ref"
  ],
  "properties": {
    "guild_identity": { "type": "object", "required": ["name", "guild_id", "founding_date"] },
    "jurisdictions": { "type": "object", "required": ["operation", "asset_holding"] },
    "legal_form": { "type": "object", "required": ["entity_type", "registration_jurisdiction"] },
    "membership_rules": { "type": "object", "required": ["join_process"] },
    "internal_governance": { "type": "object", "required": ["decision_process", "amendment_process"] },
    "currency_system": { "type": "object", "required": ["system", "compliance_annex_ref"] },
    "merit_calibration": { "type": "object", "required": ["calibration_rules"] },
    "contribution_verification": { "type": "object", "required": ["methods"] },
    "founding_orientation": {
      "type": "object",
      "required": ["statement", "field_coupled_to", "invariants"],
      "properties": {
        "invariants": { "type": "array", "minItems": 3, "maxItems": 7, "items": { "type": "string" } }
      }
    },
    "shear_detection": {
      "type": "object",
      "required": ["method", "indicators", "threshold", "review_cadence"],
      "properties": {
        "method": { "type": "string", "enum": ["peer_attestation", "metric_watch", "hybrid"] },
        "indicators": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "review_cadence": { "type": "string", "enum": ["monthly", "quarterly", "annual"] }
      }
    },
    "fork_conditions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "guardrail_declaration": { "type": "object", "required": ["compliance_statement"] },
    "conflict_of_interest": { "type": "object", "required": ["disclosure_rules", "recusal_rules"] },
    "legal_compliance": { "type": "object", "required": ["tax_integrity_statement", "disclosure_boundary_statement"] },
    "counsel_contact": { "type": "object", "required": ["contact"] },
    "legal_annex_ref": { "type": "string", "description": "Content-addressed reference to the filed legal annex." }
  }
}
