{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jackyreaps/guild-system/schemas/attestation.v1.json",
  "title": "Guild System Merit Attestation v1",
  "description": "Cross-guild merit attestation format defined by GS-CHR-009 §3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attestation_version",
    "attestation_id",
    "issuer_guild",
    "issuer_moniker",
    "issuer_public_key",
    "artifact_ref",
    "artifact_hash",
    "verification_evidence",
    "six_dimension_score",
    "issued_at",
    "signature"
  ],
  "properties": {
    "attestation_version": {
      "type": "integer",
      "const": 1
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^att_[a-f0-9]{64}$",
      "description": "att_ followed by the SHA-256 of the canonical serialization of all fields except this one and signature."
    },
    "issuer_guild": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "issuer_moniker": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "issuer_public_key": {
      "type": "string",
      "description": "Base64-encoded public key of the issuer moniker."
    },
    "artifact_ref": {
      "type": "string",
      "description": "Content-addressed reference. The world: prefix is illustrative. Any stable content-addressed store URI is acceptable, provided artifact_hash matches the resolved content."
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "verification_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "log_ref", "log_hash"],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "proof_checker",
            "proof_assistant_compilation",
            "execution_reproducible",
            "independent_replication",
            "vulnerability_reproduction",
            "independent_rerun",
            "independent_validation",
            "independent_use",
            "verified_learner_outcome",
            "longitudinal_peer_attestation",
            "two_member_peer_attestation"
          ]
        },
        "log_ref": {
          "type": "string"
        },
        "log_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "six_dimension_score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_strength",
        "novelty",
        "difficulty",
        "downstream_use",
        "robustness",
        "teaching_value"
      ],
      "properties": {
        "verification_strength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "novelty": { "type": "integer", "minimum": 0, "maximum": 5 },
        "difficulty": { "type": "integer", "minimum": 0, "maximum": 5 },
        "downstream_use": { "type": "integer", "minimum": 0, "maximum": 5 },
        "robustness": { "type": "integer", "minimum": 0, "maximum": 5 },
        "teaching_value": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded signature over the canonical serialization of all fields except signature."
    }
  }
}
